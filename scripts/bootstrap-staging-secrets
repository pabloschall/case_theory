#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
env_file="${1:-$project_root/.env}"
project_id="case-theory"
instance="case-theory-stg-postgres"
database="case_theory"
database_user="case_theory"

if [ ! -f "$env_file" ]; then
  echo "Environment file not found: $env_file" >&2
  exit 1
fi

env_value() {
  key=$1
  value=$(sed -n "s/^${key}=//p" "$env_file" | tail -n 1)
  if [ -z "$value" ]; then
    echo "Missing value for $key in $env_file" >&2
    exit 1
  fi
  printf '%s' "$value"
}

has_version() {
  [ -n "$("$project_root/scripts/gcloud" secrets versions list "$1" \
    --project="$project_id" \
    --filter='state=ENABLED' \
    --limit=1 \
    --format='value(name)')" ]
}

add_env_secret() {
  secret_name=$1
  env_name=$2
  if has_version "$secret_name"; then
    echo "$secret_name already has an enabled version; leaving it unchanged."
    return
  fi
  env_value "$env_name" | "$project_root/scripts/gcloud" secrets versions add "$secret_name" \
    --project="$project_id" \
    --data-file=- >/dev/null
  echo "Added the first version of $secret_name."
}

add_secret_key() {
  if has_version secret-key; then
    echo "secret-key already has an enabled version; leaving it unchanged."
    return
  fi

  value=$(sed -n 's/^SECRET_KEY=//p' "$env_file" | tail -n 1)
  case "$value" in
    *development-only* | *replace-with*) value="" ;;
  esac
  if [ "${#value}" -lt 32 ]; then
    value=$(openssl rand -hex 32)
  fi

  printf '%s' "$value" | "$project_root/scripts/gcloud" secrets versions add secret-key \
    --project="$project_id" \
    --data-file=- >/dev/null
  echo "Added the first version of secret-key."
}

add_secret_key
add_env_secret openai-api-key OPENAI_API_KEY
add_env_secret mailgun-api-key MAILGUN_API_KEY
add_env_secret mailgun-base-url MAILGUN_BASE_URL
add_env_secret mailgun-from-email MAILGUN_FROM_EMAIL
add_env_secret fbi-api-key FBI_API_KEY

if has_version database-url; then
  echo "database-url already has an enabled version; leaving it unchanged."
  exit 0
fi

database_password=$(openssl rand -hex 24)
if "$project_root/scripts/gcloud" sql users list \
  --project="$project_id" \
  --instance="$instance" \
  --filter="name=${database_user}" \
  --format='value(name)' | grep -qx "$database_user"; then
  "$project_root/scripts/gcloud" sql users set-password "$database_user" \
    --project="$project_id" \
    --instance="$instance" \
    --password="$database_password" \
    --quiet >/dev/null
else
  "$project_root/scripts/gcloud" sql users create "$database_user" \
    --project="$project_id" \
    --instance="$instance" \
    --password="$database_password" \
    --quiet >/dev/null
fi

database_host=$("$project_root/scripts/gcloud" sql instances describe "$instance" \
  --project="$project_id" \
  --format='value(ipAddresses.ipAddress)')
database_url="postgresql+asyncpg://${database_user}:${database_password}@${database_host}:5432/${database}"
printf '%s' "$database_url" | "$project_root/scripts/gcloud" secrets versions add database-url \
  --project="$project_id" \
  --data-file=- >/dev/null
echo "Created the staging database user and added the first database-url version."
